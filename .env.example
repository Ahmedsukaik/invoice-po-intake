# --- The intake server -------------------------------------------------------------
# One token per person or program. Roles: clerk, reviewer, admin. Two reviewers, because
# whoever corrects a document may not also approve it (FOUR_EYES).
# Generate real tokens with:  python -c "import secrets; print(secrets.token_urlsafe(32))"
INTAKE_TOKENS='{"change-me-clerk-token-000000": {"name": "tom", "role": "clerk"}, "change-me-reviewer-token-0000": {"name": "sara", "role": "reviewer"}, "change-me-reviewer2-token-000": {"name": "omar", "role": "reviewer"}, "change-me-admin-token-0000000": {"name": "ana", "role": "admin"}}'

# Where the data lives (relative to the folder you start the commands from).
INTAKE_DB=intake.db
INTAKE_STORAGE=storage
INTAKE_INBOX=inbox
INTAKE_OUTBOX=outbox
# The vendor master and PO register loaded into a new, empty database:
# INTAKE_SEED=seed

# How PDFs are read: rules (the demo layout only, no AI model) or claude.
INTAKE_EXTRACTOR=rules
MAX_UPLOAD_MB=10
MAX_PAGES=50
# A PDF that takes longer than this to parse goes to a person:
PDF_TIMEOUT_SECONDS=20
# PDFs parsed at the same time (each in its own worker process), and how long a PDF may wait
# for a free worker before it goes to a person (an inbox file waits for the next scan instead):
PDF_WORKERS=3
PDF_WAIT_SECONDS=30

# --- The checks --------------------------------------------------------------------
ALLOWED_CURRENCIES=GBP,EUR,USD
TAX_RATES=0,5,20
# Subtotal, tax and total may be off by this much (rounding):
AMOUNT_TOLERANCE=0.02
# Qty x unit price against the line amount:
LINE_TOLERANCE=0.01
PO_PRICE_TOLERANCE_PCT=2
PO_QTY_TOLERANCE_PCT=0
MAX_FUTURE_DAYS=7
MAX_PAYMENT_DAYS=180
# An invoice without a PO number is a blocking finding (false: only a warning):
REQUIRE_PO=true
# Same vendor and total within this many days, under another number: possible duplicate.
DUPLICATE_WINDOW_DAYS=10
# How the Claude reader reads 05/10/2026: dmy (day first) or mdy. Either way it is flagged.
DATE_ORDER=dmy
# Whoever typed or changed values on a document may not approve it:
FOUR_EYES=true

# --- The command line client (python -m intake.cli) -------------------------------
# If you start the server with --port, change the port here too.
INTAKE_URL=http://127.0.0.1:8200
INTAKE_TOKEN=change-me-reviewer-token-0000

# --- Only for INTAKE_EXTRACTOR=claude ----------------------------------------------
# The reader's own settings start with INTAKE_, so Claude settings a shell has for other tools
# (CLAUDE_EFFORT, ANTHROPIC_MODEL) are not picked up. Wrong values stop the start-up.
# ANTHROPIC_API_KEY=
# INTAKE_CLAUDE_MODEL=claude-sonnet-5-5
# INTAKE_CLAUDE_EFFORT=low
# INTAKE_CLAUDE_FALLBACKS=default
